{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": false,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/prep-pulse/dist/public",
  "rewrites": [
    {
      "source": "/probe1/:x",
      "destination": "/api/healthz"
    },
    {
      "source": "/probe2/:x",
      "destination": "/api/[...slug]?...slug=healthz"
    },
    {
      "source": "/share/:type/:id",
      "destination": "/api/[...slug]?...slug=share-page/:type/:id"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...slug]?...slug=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}