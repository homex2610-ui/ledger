{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/prep-pulse/dist/public",
  "rewrites": [
    {
      "source": "/p3/:x",
      "destination": "/api/[...slug]?...slug=$1"
    },
    {
      "source": "/share/(.*)",
      "destination": "/api/[...slug]?...slug=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...slug]?...slug=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}