# PrepPulse - copy to your shell environment (no .env file is loaded).
# Required:
DATABASE_URL=postgres://preppulse:preppulse@localhost:5433/preppulse

# Optional - enable Google sign-in (Google Cloud console -> Credentials ->
# OAuth 2.0 Client IDs). Set the JS origin to your deployed origin.
GOOGLE_CLIENT_ID=

# Optional - enable Discord sign-in (Discord Developer Portal -> OAuth2).
# Add your deployed origin + /api/auth/discord/callback to redirect URIs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional - automatically join Discord sign-ins to your server (server id).
# The bot must be a member of that server. Users can untick the join box on
# the Discord consent screen; joining never blocks sign-in.
# DISCORD_GUILD_ID=

# Optional - Supabase Auth for password-recovery emails. The redirect target
# in recovery emails resolves to the requesting host (production alias or
# Vercel preview) and falls back to the production origin; it must also be
# listed in the Supabase project's Redirect URLs allow-list (Site URL should
# be https://ledger-pi-topaz.vercel.app).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional - override the origin used in password-recovery email links
# (e.g. per-environment in Vercel). Defaults to the requesting host for
# vercel.app hosts, otherwise the production origin. Never localhost.
# APP_ORIGIN=

# Test-only overrides for the OAuth endpoints (used by scripts/qa-isolation.mjs).
# GOOGLE_CERTS_URL=
# DISCORD_TOKEN_URL=
# DISCORD_API_URL=
