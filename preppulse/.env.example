# PrepPulse - copy to your shell environment (no .env file is loaded).
# Required:
DATABASE_URL=postgres://preppulse:preppulse@localhost:5433/preppulse

# Optional - enable Google sign-in (Google Cloud console -> Credentials ->
# OAuth 2.0 Client IDs). Set the JS origin to your deployed origin.
GOOGLE_CLIENT_ID=

# Optional - enable Discord sign-in (Discord Developer Portal -> OAuth2).
# Add your deployed origin + /api/auth/discord/callback to redirect URIs.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Test-only overrides for the OAuth endpoints (used by scripts/qa-isolation.mjs).
# GOOGLE_CERTS_URL=
# DISCORD_TOKEN_URL=
# DISCORD_API_URL=
