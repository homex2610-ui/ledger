# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: where magic-link emails and Discord OAuth redirect after sign-in.
# Set this to your deployed URL (e.g. https://your-app.vercel.app) so links
# don't bounce back to localhost. Falls back to window.location.origin.
# VITE_REDIRECT_URL=https://your-app.vercel.app

# Optional: the official Ledger Discord server invite (a public discord.gg
# URL). When set, "Join Ledger Discord" CTAs render in Community, the
# profile panel and Stories. Leave empty to hide them.
VITE_DISCORD_INVITE_URL=
